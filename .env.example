# Local server configuration. Never prefix secrets with VITE_.
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/subtrack.sqlite
MAIL_MODE=outbox
# outbox proves generation only. SMTP is required for real delivery evidence.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Explicit allowlist of approved test recipients (comma separated).
MAIL_ALLOWED_RECIPIENTS=
# Optional quotation suggestions; off unless all three settings are configured.
# Keep the existing server-only key private. No VITE_ credential variables.
OPENAI_API_KEY=
AI_QUOTE_ENABLED=false
# Explicit approved USD allowance, >0 and <=5. Invalid/missing allowance disables AI.
# The persisted allowance is shared by users of ONE application database.
AI_QUOTE_BUDGET_USD=0
